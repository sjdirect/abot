<Project Sdk="MSTest.Sdk/4.5.2">

  <PropertyGroup>
    <!-- One test target per build of Abot: net10.0, netstandard2.0 (used by net8.0) and net462 (used by net462 and net472,
         which pick different builds of Abot's dependencies). Every .NET Framework target runs on the installed 4.8.x runtime. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(OS)' == 'Windows_NT' ">$(TargetFrameworks);net462;net472</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abot2\Abot2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

</Project>
